{
  "name": "@socratica/cli",
  "version": "0.3.2",
  "description": "socratica: fact-check text against evidence from the command line. Works offline, with your own API key, or with a local OpenAI-compatible model.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "socratica": "./dist/socratica.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@socratica/core": "workspace:*",
    "undici": "6.29.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
