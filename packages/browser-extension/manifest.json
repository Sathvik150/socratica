{
  "manifest_version": 3,
  "name": "Hallucination Firewall",
  "version": "0.1.2",
  "description": "Checks ChatGPT answers against retrieved evidence: claims are marked supported, contradicted or unverifiable, with source quotes.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://en.wikipedia.org/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.search.brave.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Hallucination Firewall",
    "default_popup": "popup.html"
  }
}
