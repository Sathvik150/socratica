{
  "name": "socratica",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Model-independent, evidence-linked fact verification for chatbot answers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sathvik150/cac26.git"
  },
  "keywords": [
    "fact-checking",
    "hallucination",
    "llm",
    "chatgpt",
    "chrome-extension",
    "verification",
    "agent-skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "preinstall": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('\\n  This repo uses pnpm. Run: corepack enable && pnpm install\\n');process.exit(1)}\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bench": "pnpm --filter @socratica/benchmark bench",
    "package": "node scripts/package.mjs",
    "release": "pnpm build && pnpm package"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
