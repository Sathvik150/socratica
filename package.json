{
  "name": "hallucination-firewall",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Model-independent, evidence-linked fact verification for chatbot answers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sathvik150/cac26.git"
  },
  "keywords": [
    "fact-checking",
    "hallucination",
    "llm",
    "chatgpt",
    "chrome-extension",
    "verification",
    "agent-skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bench": "pnpm --filter @hallucination-firewall/benchmark bench",
    "package": "node scripts/package.mjs",
    "release": "pnpm build && pnpm package"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
